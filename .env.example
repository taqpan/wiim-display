# --- WiiM 接続 ---

# WiiM Pro の固定IPアドレス（DHCP予約を推奨）
WIIM_HOST=192.168.1.100

# WiiM HTTP API のタイムアウト秒数
WIIM_TIMEOUT=3.0


# --- ポーリング ---

# getPlayerStatus のポーリング間隔（秒）。再生状態ごとに使い分ける
POLL_INTERVAL_PLAYING=3.0
POLL_INTERVAL_PAUSED=5.0
POLL_INTERVAL_IDLE=15.0

# 連続失敗時に指数バックオフで広げるポーリング間隔の上限（秒）
POLL_MAX_INTERVAL=30.0


# --- 操作コマンドの確定 ---

# コマンド送出後に getPlayerStatus を再取得する間隔と、変化を待つ上限（秒）
# 固定待機ではなく変化の検出で確定させる（docs/adr.md ADR-011）
COMMAND_CONFIRM_INTERVAL=0.1
COMMAND_CONFIRM_TIMEOUT=1.0


# --- 画面配信サーバ ---

# 待ち受けアドレス。本番は 127.0.0.1、開発時に外部から確認する場合のみ 0.0.0.0
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# サーバ側で縮小するアルバムアートの一辺のピクセル数。app.css の --art-size と一致させる
ART_SIZE=300


# --- バックライト（Pi 実機のみ） ---

# 輝度制御ファイルのパス。空にすると制御を無効化する（開発環境では空にする）
BACKLIGHT_PATH=/sys/class/backlight/10-0045/brightness

# 通常時とアイドル時の輝度（0-255）。0 で消灯
# 応答は非線形で、30 以下は消灯と区別がつかない。減光した常時表示にする場合は 64 以上を指定する
BACKLIGHT_LEVEL_ON=255
BACKLIGHT_LEVEL_IDLE=0

# 停止状態がこの秒数続いたらアイドル輝度に落とし、タッチで復帰する
IDLE_TIMEOUT=300


# --- 電源操作 ---

# 1 で画面からのシャットダウン / 再起動を許可する。開発環境では 0 のままにする
# 有効化には Pi 側で sudoers の設定が必要（docs/setup-pi.md 参照）
ALLOW_POWER=0


# --- 開発・診断 ---

# 1 でモック状態の切替やCSSホットリロードを有効化する。本番は 0
DEV_MODE=0

# 1 で WiiM に接続せず固定フィクスチャを返す
WIIM_MOCK=0

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
